PORT=4000
NODE_ENV=development

# Database Configuration (for local PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=angel_marketplace
DB_PORT=5432
DB_HOST=localhost

# Prisma Database URL (uses local PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/angel_marketplace?schema=public

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset (forgot/reset password email)
# Option A: Zepto Mail REST API (v1.1) ΓÇô same as your NestJS app
# Get API key from Zepto Mail dashboard; auth header: Zoho-enczapikey <key>
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=noreply@yourdomain.com
ZEPTOMAIL_FROM_NAME=Angel Marketplace

# Option B: Generic SMTP (e.g. Zepto SMTP: smtp.zeptomail.com, port 587, username: emailapikey, password: from dashboard)
# If both Zepto token and SMTP are set, Zepto Mail API is used first
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emailapikey
SMTP_PASS=
SMTP_FROM="Angel Marketplace <noreply@yourdomain.com>"

PASSWORD_RESET_BASE_URL=http://localhost:4000

# Stripe (aligned with PHP Stripe/ config: test vs live)
# Option A: Single key (any env)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# Option B: Separate test/live like PHP (paste keys from Stripe Dashboard)

STRIPE_ENVIRONMENT=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
