PORT=4000
NODE_ENV=development

# Database Configuration (for local PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=angel_marketplace
DB_PORT=5432
DB_HOST=localhost

# Prisma Database URL (uses local PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/angel_marketplace?schema=public

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

